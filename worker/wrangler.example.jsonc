{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-hours-delivery",
  "main": "src/entry.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true }, "traces": { "enabled": false } },
  "vars": {
    "REPORT_FROM": "reports@example.com",
    "REPORT_TO": "recipient@example.com",
    "MAX_DAILY_EMAILS": "50",
    "DELIVERY_LOGS": "true"
  },
  "send_email": [
    { "name": "EMAIL", "destination_address": "recipient@example.com" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-hours-delivery",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "SUBMISSION_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }
  ]
}
