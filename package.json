{
  "name": "agent-hours-local-classifier",
  "version": "0.1.2",
  "description": "Private local AI activity reports with TimeSentry",
  "private": true,
  "type": "module",
  "bin": {
    "agent-hours": "bin/agent-hours"
  },
  "files": ["bin", "src", "README.md", "SECURITY.md", "worker/README.md"],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "test": "bun test tests-ts",
    "typecheck": "tsc --noEmit",
    "worker:check": "bun run --bun wrangler deploy --dry-run --config worker/wrangler.example.jsonc",
    "worker:deploy": "bun run --bun wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@opencode/client": "2.2.7",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@js-temporal/polyfill": "0.5.1",
    "decimal.js": "10.6.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "typescript": "5.9.3",
    "wrangler": "4.160.1"
  }
}
